# ===========================================
# mailctl - Docker Environment Configuration
# Copy to .env and customise:
#   cp .env.example .env
# ===========================================

# ===========================================
# DATABASE MODE
#
# Two supported routes. Pick exactly one.
#
#   local     Bundled postgres:18 container on the Compose network.
#             No TLS, and the port is NOT published to the host - only
#             sibling containers can reach it at postgres:5432.
#             Nothing below the "external" block is used.
#
#   external  Remote PostgreSQL reached over TLS. The connection is
#             enforced as sslmode=verify-full (validates the server
#             certificate against the CA and checks the hostname) plus
#             channelBinding=require (binds SCRAM auth to the TLS channel
#             so a captured exchange cannot be replayed). The bundled
#             postgres container is not started in this mode.
#             The server must be PostgreSQL 12+ using SCRAM-SHA-256.
# ===========================================
MAILCTL_DB_MODE=local

# --- local mode only ---
# Leave MAILCTL_DB_HOST=postgres so mailctl reaches the sibling container.
POSTGRES_DATABASE=mailctl
POSTGRES_USERNAME=mailctl
POSTGRES_PASSWORD=changeme_secure_password

# --- external mode only ---
# MAILCTL_DB_HOST=db.example.com
# MAILCTL_DB_PORT=5432
# MAILCTL_DB_NAME=mailctl
# MAILCTL_DB_USER=mailctl
# MAILCTL_DB_PASSWORD=replace_with_the_real_password

# Must be verify-full. Anything weaker is refused by both start.sh and the
# container entrypoint, so a downgrade cannot happen silently.
# MAILCTL_DB_SSL_MODE=verify-full

# CA that signed the server certificate. Container path; the host copy lives
# in keys/ (mounted read-only at /etc/mailctl/keys).
# MAILCTL_DB_SSL_ROOT_CERT=/etc/mailctl/keys/rootCA.crt

# Optional mTLS client material. When both are set, mailctl presents a client
# certificate in addition to verifying the server.
# MAILCTL_DB_SSL_CERT=/etc/mailctl/keys/client.crt
# MAILCTL_DB_SSL_KEY=/etc/mailctl/keys/client.key

# ===========================================
# MAIL IDENTITY (required)
# ===========================================
MAIL_DOMAIN=example.com
# Must resolve to this host and match the server's PTR record, or mail is
# rejected by most receivers.
MAIL_HOSTNAME=mail.example.com
MAIL_POSTMASTER=postmaster@example.com

# TLS certificate paths (inside the mailctl container).
# Place the cert/key under config/tls/ on the host.
MAIL_TLS_CERT=/etc/mailctl/tls/mailcert.pem
MAIL_TLS_KEY=/etc/mailctl/tls/mailkey.pem

# --- Postfix submission account (used by the postfix container) ---
SMTP_USER=postfix
SMTP_PASSWORD=changeme_smtp_password

# --- JVM options for the mailctl container ---
# Note: do not wrap this value in quotes here; Docker Compose handles it.
JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
