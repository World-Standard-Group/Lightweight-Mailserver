# Docker Environment Configuration
# Copy to .env and customize

# PostgreSQL
POSTGRES_USERNAME=mail_sv
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DATABASE=mail_sv
POSTGRES_SSL=true
POSTGRES_CA_FILE=
POSTGRES_PV_FILE=
POSTGRES_CERTIFICATE=

# Mail Domain
MAIL_DOMAIN=example.com

# SMTP Credentials (for postfix container)
SMTP_USER=postfix
SMTP_PASSWORD=changeme_smtp_password

# Java Options
JAVA_OPTS=-Xms256m -Xmx512m